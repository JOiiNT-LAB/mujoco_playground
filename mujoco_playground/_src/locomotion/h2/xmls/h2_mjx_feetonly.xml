<mujoco model="h2">
  <!--
    H2 feet-only model for the joystick task, structured like g1_mjx_feetonly.xml.
    Sources: [MJCF] unitree_mujoco h2_mujoco.xml (kinematics, inertias, joints, limits, armature,
    frictionloss), [URDF] unitree_ros H2.urdf (pelvis inertial), [MJLAB] unitree_rl_mjlab
    h2_constants.py (PD gains). UNSURE marks values with no official source.
  -->
  <compiler angle="radian"/>

  <option iterations="3" ls_iterations="5" timestep=".002" integrator="Euler">
    <flag eulerdamp="disable"/>
  </option>

  <default>
    <default class="h2">
      <geom condim="1" contype="0" conaffinity="0"/>

      <!-- kd is applied as joint damping, as in G1: [MJLAB] kd + [MJCF] passive 0.05. -->
      <joint armature="0.01" frictionloss="0.2"/>

      <default class="leg">
        <!-- [MJLAB] kp 200, kd 4. -->
        <position inheritrange="1" kp="200"/>
        <joint damping="4.05"/>
        <default class="hip_pitch">
          <joint axis="0 1 0" range="-2.4526 2.77542" actuatorfrcrange="-360 360"/>
        </default>
        <default class="hip_roll">
          <joint axis="1 0 0" actuatorfrcrange="-360 360"/>
        </default>
        <default class="hip_yaw">
          <joint axis="0 0 1" range="-2.827 2.827" actuatorfrcrange="-360 360"/>
        </default>
        <default class="knee">
          <joint axis="0 1 0" range="-0.08725 2.53025" actuatorfrcrange="-360 360"/>
        </default>
      </default>
      <default class="ankle">
        <!-- [MJLAB] kp 40, kd 2. -->
        <position inheritrange="1" kp="40"/>
        <joint damping="2.05"/>
        <default class="ankle_roll">
          <joint axis="1 0 0" actuatorfrcrange="-19 19"/>
        </default>
        <default class="ankle_pitch">
          <!-- Torque limit [MJCF]; [MJLAB] uses 66 Nm. -->
          <joint axis="0 1 0" range="-1.13446 0.610865" actuatorfrcrange="-66.88 66.88"/>
        </default>
      </default>
      <default class="waist">
        <!-- [MJLAB] kp 150, kd 3. -->
        <position inheritrange="1" kp="150"/>
        <joint damping="3.05"/>
        <default class="waist_yaw">
          <joint axis="0 0 1" range="-1.7453 1.7453" actuatorfrcrange="-120 120"/>
        </default>
        <default class="waist_roll">
          <joint axis="1 0 0" range="-0.5236 0.5236" actuatorfrcrange="-180 180"/>
        </default>
        <default class="waist_pitch">
          <joint axis="0 1 0" range="-0.43633 0.5236" actuatorfrcrange="-180 180"/>
        </default>
      </default>
      <default class="head">
        <!-- UNSURE: no official gains ([MJLAB] welds the head); wrist gains used. -->
        <position inheritrange="1" kp="20"/>
        <joint damping="1.05"/>
        <default class="head_pitch">
          <joint axis="0 1 0" range="-0.5236 0.83775" actuatorfrcrange="-50 50"/>
        </default>
        <default class="head_yaw">
          <joint axis="0 0 1" range="-1.7453 1.7453" actuatorfrcrange="-50 50"/>
        </default>
      </default>
      <default class="arm">
        <!-- [MJLAB] kp 40, kd 2. Torque limits [MJCF]; [MJLAB] uses 54 Nm. -->
        <position inheritrange="1" kp="40"/>
        <joint damping="2.05"/>
        <default class="shoulder_pitch">
          <joint axis="0 1 0" range="-2.618 1.833" actuatorfrcrange="-130 130"/>
        </default>
        <default class="shoulder_roll">
          <joint axis="1 0 0" actuatorfrcrange="-60 60"/>
        </default>
        <default class="shoulder_yaw">
          <joint axis="0 0 1" range="-2.618 2.618" actuatorfrcrange="-60 60"/>
        </default>
        <default class="elbow">
          <joint axis="0 1 0" range="-0.986 3.071" actuatorfrcrange="-60 60"/>
        </default>
        <default class="wrist_roll">
          <joint axis="1 0 0" range="-2.618 2.618" actuatorfrcrange="-60 60"/>
        </default>
      </default>
      <default class="wrist">
        <!-- [MJLAB] kp 20, kd 1. Limits [MJCF]; [MJLAB] uses 25 Nm, pitch +-0.436. -->
        <position inheritrange="1" kp="20"/>
        <joint damping="1.05"/>
        <default class="wrist_pitch">
          <joint axis="0 1 0" range="-0.576 0.576" actuatorfrcrange="-10 10"/>
        </default>
        <default class="wrist_yaw">
          <joint axis="0 0 1" range="-1.22 1.22" actuatorfrcrange="-10 10"/>
        </default>
      </default>

      <default class="visual">
        <geom group="2" type="mesh" density="0" material="silver"/>
      </default>
      <default class="collision">
        <geom group="3" rgba=".2 .6 .2 .3"/>
      </default>
      <site group="5" rgba="1 0 0 1"/>
    </default>
  </default>

